# ── App ───────────────────────────────────────────────────────────────
DEBUG=true
APP_NAME=Babe's Bookstore
PORT=8000

# ── Database / Redis ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/babes_bookstore
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/babes_bookstore
REDIS_URL=redis://localhost:6379/0

# ── Celery (worker process) ───────────────────────────────────────────
# Parallel tasks per worker. Scale with the VM's CPU count on Fly.
CELERY_CONCURRENCY=2
# Override Celery timeouts for the long ~74k-book Gutenberg harves if needed.

# ── Rate limiting (in-memory sliding window per IP) ───────────────────
# Tuned in app/middleware.py DEFAULT_LIMITS. Per route:
#   checkout 10/min, auth 20/min, admin 60/min, other API 120/min

# ── Periodic jobs (Celery Beat, UTC) ──────────────────────────────────
#   03:00 daily  — re-verify pending licences (verify.licenses.all)
#   :15 hourly   — clean up expired download links (periodic.cleanup_expired)
# Schedule lives in app/celery_app.py beat_schedule.

# ── Security ──────────────────────────────────────────────────────────
SECRET_KEY=change-me-use-openssl-rand-hex-32

# ── Pricing (store-wide defaults; each bundle can override) ───────────
STANDARD_PRICE_PENCE=1000
CURRENCY=gbp
CURRENCY_SYMBOL=£
DOWNLOAD_WINDOW_HOURS=24

# ── URLs ──────────────────────────────────────────────────────────────
# Public API host (used to derive the OAuth redirect in production)
PRODUCTION_URL=https://babes-bookstore.fly.dev
# Where customers land after paying
FRONTEND_URL=https://babesbooks.store

# ── Google OAuth ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── Cloudflare R2 (leave blank until configured) ─────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=babes-bookstore
R2_PUBLIC_URL=

# ── Stripe ────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── PayPal ────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# ── Square ────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox

# ── Email (SendGrid) ─────────────────────────────────────────────────
SENDGRID_API_KEY=SG.xxx
FROM_EMAIL=noreply@babesbookstore.com

# ── Admin accounts (auto-created on startup with free downloads) ─────
# JSON list, e.g. ADMIN_EMAILS=["you@example.com"]
ADMIN_EMAILS=[]
