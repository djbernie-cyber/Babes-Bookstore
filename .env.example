# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/babes_bookstore
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/babes_bookstore

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=change-me-use-openssl-rand-hex-32

# Standard Pricing (£10 GBP)
STANDARD_PRICE_PENCE=1000
CURRENCY=gbp
CURRENCY_SYMBOL=£

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=babes-bookstore
R2_PUBLIC_URL=https://your-bucket.your-account.r2.dev

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Square
SQUARE_ACCESS_TOKEN=your-square-access-token
SQUARE_LOCATION_ID=your-square-location-id
SQUARE_ENVIRONMENT=sandbox

# SendGrid
SENDGRID_API_KEY=SG.xxx
FROM_EMAIL=noreply@babesbookstore.com

# App
DEBUG=true
APP_NAME=Babe's Bookstore